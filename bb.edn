;; Babashka project config for the dotagents repository.
;;
;; - :paths / :deps drive both `bb` task execution and `bbin install`.
;; - Maven coordinates/versions are intentionally identical to deps.edn; keep
;;   both files aligned and do not introduce duplicate git pins.
;; - :bbin/bin advertises `ot` as the installable entry point. Third
;;   parties install via:
;;       bbin install io.github.cormacc/dotagents --as ot --latest-sha
;;   In-tree dev runs via `bb run ot …` or skills/org-tasks/scripts/ot.
;; - :tasks keeps the pre-existing dotagents bb tasks alongside the
;;   `ot`, `subagent`, and test entries.
{:paths    ["skills/org-tasks/scripts/src"
            "skills/herdr-orch/scripts/src"]
 :deps     {org.babashka/cli {:mvn/version "0.12.75"}
            io.github.paintparty/bling {:mvn/version "0.10.0"}
            de.timokramer/charm.clj {:mvn/version "0.2.71"}
            no.cjohansen/nexus {:mvn/version "2026.06.4"}}
 :bbin/bin {ot {:main-opts ["-m" "org-tasks.cli"]}}
 :tasks
 {:requires [[clojure.string :as str]
             [babashka.fs :as fs]
             [babashka.process :as process]]

  ;; ── ot CLI ───────────────────────────────────────────────────────
  ot   {:doc  "Run the in-tree ot CLI (org-tasks.cli/-main)"
        :task (apply (requiring-resolve 'org-tasks.cli/-main)
                     *command-line-args*)}

  subagent {:doc "Run the in-tree subagent CLI (herdr-orch.cli/-main)"
            :task (apply (requiring-resolve 'herdr-orch.cli/-main)
                         *command-line-args*)}

  traits {:doc "Run the trait interpolator CLI (herdr-orch.traits-cli/-main)"
          :task (apply (requiring-resolve 'herdr-orch.traits-cli/-main)
                       *command-line-args*)}

  test-clojure {:doc  "Run the org-tasks and herdr-orch Clojure test suites"
                :task (do (require 'babashka.classpath)
                          (doseq [path ["skills/org-tasks/scripts/test"
                                        "skills/herdr-orch/scripts/test"]]
                            ((requiring-resolve 'babashka.classpath/add-classpath) path))
                          (apply (requiring-resolve 'org-tasks.test-runner/run)
                                 *command-line-args*))}

  test {:doc  "Run all Clojure and repository script tests"
        :task (do (process/check
                    (process/process (into ["bb" "test-clojure"] *command-line-args*)
                                     {:inherit true}))
                  (process/check
                    (process/process ["bb" "scripts/test-run-trait-gate.bb"]
                                     {:inherit true})))}

  smoke-subagent {:doc "Run explicitly guarded live Herdr subagent smoke (set ORCH_LIVE_SMOKE_KIND=claude to exercise Claude)"
                  :task (apply (requiring-resolve 'herdr-orch.smoke/-main)
                               *command-line-args*)}

  ;; ── existing dotagents tasks ────────────────────────────────────
  hello    {:doc  "Print a greeting"
            :task (println "Hello from bb-tasks!")}

  echo     {:doc  "Echo arguments back"
            :task (println (str "Args: " (str/join " " *command-line-args*)))}

  files    {:doc  "List nix files in repo root"
            :task (doseq [f (sort (fs/glob "." "*.nix"))]
                    (println (str f)))}

  watch-echo {:doc  "Long-running watch process (prints every 2s)"
              :task (loop [i 1]
                      (println (str "[" i "] watching... " (java.time.LocalTime/now)))
                      (Thread/sleep 2000)
                      (recur (inc i)))}}}
