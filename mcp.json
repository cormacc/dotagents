{
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "auth": "oauth"
    },
    "ms365": {
      "url": "http://127.0.0.1:3365/mcp",
      "auth": "oauth",
      "oauth": {
        "redirectUri": "http://localhost:{port}/callback",
        "clientName": "pi"
      }
    },
    "context-mode": {
      "command": "context-mode"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://strix:8888"
      }
    }
  }
}
