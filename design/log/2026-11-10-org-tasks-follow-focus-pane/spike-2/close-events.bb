(require '[babashka.classpath :as cp]) (cp/add-classpath "herdr/plugins/org-tasks/src")
(require '[org-tasks-host :as host] '[babashka.fs :as fs] '[babashka.process :as p] '[cheshire.core :as j] '[clojure.string :as str])
(def token (subs (str (random-uuid)) 0 8)) (def base (str "/tmp/ce-" token)) (def session (str "ce" token))
(def binary (str (fs/which "herdr")))
(doseq [d ["/config/herdr" "/state" "/runtime" "/work"]] (fs/create-dirs (str base d)))
(def env (merge (into {} (remove (fn [[k _]] (re-find #"^(HERDR_|HC_|ORCH_|OT_)" k)) (System/getenv)))
                {"XDG_CONFIG_HOME" (str base "/config") "XDG_STATE_HOME" (str base "/state") "XDG_RUNTIME_DIR" (str base "/runtime")}))
(defn run! [& args] (let [r (deref (p/process (into [binary "--session" session] args) {:env env :out :string :err :string}) 15000 nil)]
                      (when-not (and r (zero? (:exit r))) (throw (ex-info "CLI failed" {:args args :r (select-keys r [:exit :err])})))
                      (:result (j/parse-string (:out r) true))))
(def all-types ["workspace.created" "workspace.updated" "workspace.closed" "workspace.focused" "tab.created" "tab.closed"
                "tab.focused" "pane.created" "pane.closed" "pane.updated" "pane.focused" "pane.moved" "pane.exited" "layout.updated"])
(def server (atom nil))
(try
  (spit (str base "/config/herdr/config.toml") "onboarding = false\n")
  (reset! server (p/process [binary "--session" session "server"] {:env env :out :write :out-file (str base "/server.log") :err :out}))
  (loop [n 60] (when (and (pos? n) (not (try (run! "api" "snapshot") (catch Exception _ nil)))) (Thread/sleep 250) (recur (dec n))))
  (let [w (run! "workspace" "create" "--cwd" (str base "/work") "--focus")
        t2r (run! "tab" "create" "--cwd" (str base "/work") "--focus")
        t2 (get-in t2r [:tab :tab_id]) p2 (get-in t2r [:root_pane :pane_id])
        conn (host/subscribe! (str base "/config/herdr/sessions/" session "/herdr.sock") all-types)
        seen (atom [])
        _ (future (host/events! conn #(swap! seen conj [(:event %) (select-keys (:data %) [:tab_id :pane_id :workspace_id])])))]
    (Thread/sleep 300)
    (println "BEFORE focused tab" (:focused_tab_id (:snapshot (run! "api" "snapshot"))) "mode" (first *command-line-args*))
    (case (first *command-line-args*)
      "tab" (run! "tab" "close" t2)
      "workspace" (let [w2 (run! "workspace" "create" "--cwd" (str base "/work") "--focus")]
                    (Thread/sleep 500) (reset! seen [])
                    (println "focused before workspace close" (:focused_tab_id (:snapshot (run! "api" "snapshot"))))
                    (run! "workspace" "close" (get-in w2 [:workspace :workspace_id])))
      (run! "pane" "close" p2))
    (Thread/sleep 1500)
    (println "AFTER focused tab" (:focused_tab_id (:snapshot (run! "api" "snapshot"))))
    (doseq [e @seen] (println "EVENT" (pr-str e))))
  (finally
    (try (run! "server" "stop") (catch Exception _ nil))
    (when (and @server (nil? (deref @server 5000 nil))) (p/destroy-tree @server))
    (deref (p/process [binary "--session" session "session" "delete" session "--json"] {:env env :out :string :err :string}) 8000 nil)
    (fs/delete-tree base)
    (println "CLEANED" (not (fs/exists? base)))))
