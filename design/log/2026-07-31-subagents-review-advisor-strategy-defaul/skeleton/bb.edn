{:paths ["src" "test"]
 :tasks {test {:doc "Run the visible smoke tests"
               :requires ([clojure.test :as t]
                          [orgmini-smoke-test])
               :task (let [{:keys [fail error]} (t/run-tests 'orgmini-smoke-test)]
                       (when (pos? (+ fail error))
                         (System/exit 1)))}}}
