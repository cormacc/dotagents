#!/usr/bin/env bash
# Score one executor cell against the hidden acceptance suite.
#
#   ./score <cell-dir> [label] [--edn <out.edn>]
#
# <cell-dir> is a seeded cell containing src/segwin.clj. Its src/ goes on the
# classpath ahead of this directory, so the cell's implementation is the one
# under test. Exits non-zero when any case does not pass.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: $(basename "$0") <cell-dir> [label] [--edn <out.edn>]" >&2
  exit 2
fi

cell="$1"; shift
if [[ ! -f "$cell/src/segwin.clj" ]]; then
  echo "error: $cell/src/segwin.clj not found" >&2
  exit 2
fi

acc="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
label="${1:-$(basename "$cell")}"
[[ $# -gt 0 && "$1" != --* ]] && shift || true

exec bb --classpath "$cell/src:$acc" -m segwin-acceptance "$label" "$@"
