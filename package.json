{
  "name": "@cormacc/agent-org-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "Org-memory task protocol skills (org-tasks, org-plan, org-jira) plus the pi extensions that implement them (tasks, jira, emacsclient).",
  "keywords": ["pi-package", "org-mode", "task-management", "agent-skills"],
  "license": "MIT",
  "author": "Cormac Cannon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormacc/dotagents.git"
  },
  "homepage": "https://github.com/cormacc/dotagents",
  "bugs": {
    "url": "https://github.com/cormacc/dotagents/issues"
  },
  "pi": {
    "extensions": [
      "./pi/extensions/tasks",
      "./pi/extensions/jira",
      "./pi/extensions/emacsclient"
    ],
    "skills": [
      "./skills/org-tasks",
      "./skills/org-plan",
      "./skills/org-jira"
    ]
  },
  "scripts": {
    "check": "bash scripts/check.sh",
    "check:extensions": "bash scripts/check-extensions.sh",
    "check:metadata": "tsx scripts/check-metadata.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:nix": "nix flake check --impure --no-build"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "tsx": "4.23.1",
    "yaml": "2.9.0"
  },
  "files": [
    "pi/extensions/tasks",
    "pi/extensions/jira",
    "pi/extensions/emacsclient",
    "pi/extensions/lib",
    "skills/org-tasks",
    "skills/org-plan",
    "skills/org-jira",
    "README.md"
  ]
}
