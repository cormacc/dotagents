#!/usr/bin/env bash
# In-tree wrapper for the `ot` (org-tasks) CLI.
#
# Resolves the dotagents repo root from this script's location and
# runs bb against the in-tree bb.edn / source tree. Suitable for
# development from a checkout without `bbin install`.
#
# Recommended install for general use:
#
#     bbin install io.github.cormacc/dotagents --as ot --latest-sha
#
# which produces a self-contained shim under ~/.local/bin/ot.
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *)  script_path="$(cd "$(dirname "$script_path")" && pwd)/$link_target" ;;
  esac
done

script_dir="$(cd "$(dirname "$script_path")" && pwd)"
# scripts/ → org-tasks/ → skills/ → repo root when running from a full
# dotagents checkout. Home Manager / standalone skill installs may only
# expose the skill subtree under ~/.agents, so fall back to a source-classpath
# invocation in that case.
repo_root="$(cd "$script_dir/../../.." && pwd)"

if [ -f "$repo_root/bb.edn" ]; then
  exec bb --config "$repo_root/bb.edn" --deps-root "$repo_root" \
          -m org-tasks.cli -- "$@"
else
  cd "$script_dir"
  exec bb -Sdeps '{:paths ["src"] :deps {io.github.paintparty/bling {:mvn/version "0.10.0"}}}' \
          -m org-tasks.cli -- "$@"
fi
