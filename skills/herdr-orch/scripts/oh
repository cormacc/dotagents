#!/usr/bin/env bash
# In-tree wrapper for the Herdr orchestration CLI (oh).
#
# Never `cd` before `exec`: the CLI treats its own cwd as the caller's project
# (it becomes the child pane's `--cwd` and the `git rev-parse` probe behind the
# assignment root/roster). Resolve every path explicitly instead, and use
# `cd -P` so *directory* symlinks on the deployed path (`~/.agents/skills` is
# one) are canonicalised — the symlink loop below only sees the final component.
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *) script_path="$(cd -P "$(dirname "$script_path")" && pwd)/$link_target" ;;
  esac
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
case "$script_path" in
  /*) ;;
  *) script_path="$script_dir/$(basename "$script_path")" ;;
esac
repo_root="$(cd -P "$script_dir/../../.." && pwd)"
export HERDR_ORCH_BIN="$script_path"

if [ -f "$repo_root/bb.edn" ]; then
  exec bb --config "$repo_root/bb.edn" --deps-root "$repo_root" -m herdr-orch.cli -- "$@"
else
  # A bare skill-subtree install. `-Sdeps` rejects absolute `:paths` entries
  # whenever the caller's cwd holds a bb.edn, so keep `:paths` relative and
  # anchor it with --deps-root.
  exec bb --deps-root "$script_dir" -Sdeps '{:paths ["src"]}' -m herdr-orch.cli -- "$@"
fi
