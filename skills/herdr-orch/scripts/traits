#!/usr/bin/env bash
# In-tree wrapper for the standalone trait interpolator CLI.
#
# Preserve the caller's cwd: it is the project context supplied by the pi
# extension. Resolve directory and final-component symlinks so the deployed
# ~/.agents/skills path reaches this checkout's root bb.edn.
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *) script_path="$(cd -P "$(dirname "$script_path")" && pwd)/$link_target" ;;
  esac
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
repo_root="$(cd -P "$script_dir/../../.." && pwd)"

if [ -f "$repo_root/bb.edn" ]; then
  exec bb --config "$repo_root/bb.edn" --deps-root "$repo_root" traits -- "$@"
else
  exec bb --deps-root "$script_dir" -Sdeps '{:paths ["src"]}' \
       -m herdr-orch.traits-cli -- "$@"
fi
