;; Canonical model-ID → per-harness-syntax lookup table, in two levels.
;;
;; `:harnesses` declares how each resolved kind receives a model (currently a
;; single `--model` flag for all three); the kind set is open — an override
;; may add an entry for a new kind (e.g. `:gemini`) with no code change.
;;
;; `:models` maps a canonical, pi-style `provider/model` ID to a sparse row of
;; harness-native spellings for the *other* kinds.
;; `:aliases` maps a short or weight name to its canonical ID
;;
;; `:defaults` contains spawn defaults. `:placement` is :split, :tab, or :tab-split;
;; :tab-split chooses tab at root and split below root. Placement is never inherited.
;; The shipped value is :tab-split: with promiscuous spawning, one tab per first-level
;; subagent stays reviewable and recoverable, where splitting every root child produces an
;; ever-narrowing column, while a grandchild still splits so a nested unit reads as a unit.
;;
;; Override chain (project wins): this file (default) ← ~/.agents/subagents/config.edn
;; ← <assignment-root>/.agents/subagents/config.edn. `:models` rows and `:harnesses`
;; entries replace wholesale; `:aliases` and `:defaults` merge per key.
{:defaults {:placement :tab-split}
 :harnesses {:pi     {:model-flag "--model"}
             :claude {:model-flag "--model"}
             :codex  {:model-flag "--model"}}
 :models {"anthropic/claude-fable-5-1" {:claude "fable"            :codex "gpt-6-astra"}
          "anthropic/claude-opus-5-5"  {:claude "opus"             :codex "gpt-6-sol"}
          "anthropic/claude-sonnet-5"  {:claude "sonnet"           :codex "gpt-5.6-terra"}
          "anthropic/claude-haiku-4-5" {:claude "claude-haiku-4-5" :codex "gpt-6-luna"}
          "openai-codex/gpt-6-astra"   {:claude "fable"            :codex "gpt-6-astra"}
          "openai-codex/gpt-6-sol"     {:claude "opus"             :codex "gpt-6-sol"}
          "openai-codex/gpt-5.6-terra" {:claude "sonnet"           :codex "gpt-5.6-terra"}
          "openai-codex/gpt-6-luna"    {:claude "claude-haiku-4-5" :codex "gpt-6-luna"}}
 :aliases {"heavy"            "anthropic/claude-fable-5-1"
           "middle"           "anthropic/claude-opus-5-5"
           "light"            "anthropic/claude-sonnet-5"
           "feather"          "anthropic/claude-haiku-4-5"
           "claude-fable"     "anthropic/claude-fable-5-1"
           "claude-opus"      "anthropic/claude-opus-5-5"
           "claude-sonnet"    "anthropic/claude-sonnet-5"
           "claude-haiku"     "anthropic/claude-haiku-4-5"
           "gpt-astra"        "openai-codex/gpt-6-astra"
           "gpt-sol"          "openai-codex/gpt-6-sol"
           "gpt-terra"        "openai-codex/gpt-5.6-terra"
           "gpt-luna"         "openai-codex/gpt-6-luna"
           "claude-fable-5-1" "anthropic/claude-fable-5-1"
           "claude-opus-5-5"    "anthropic/claude-opus-5-5"
           "claude-sonnet-5"  "anthropic/claude-sonnet-5"
           "claude-haiku-4-5" "anthropic/claude-haiku-4-5"
           "gpt-6-astra"      "openai-codex/gpt-6-astra"
           "gpt-6-sol"      "openai-codex/gpt-6-sol"
           "gpt-5.6-terra"    "openai-codex/gpt-5.6-terra"
           "gpt-6-luna"     "openai-codex/gpt-6-luna"}}
