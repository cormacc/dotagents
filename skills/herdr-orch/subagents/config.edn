;; Canonical model-ID → per-harness-syntax lookup table, in two levels.
;;
;; `:harnesses` declares how each resolved kind receives a model (currently a
;; single `--model` flag for all three) and an effort/thinking level via
;; `:effort-flag`; the kind set is open — an override may add an entry for a
;; new kind (e.g. `:gemini`) with no code change.
;;
;; `:effort-flag` is an optional string template; a kind without one receives
;; no effort args. A template containing `{}` splits on whitespace and
;; substitutes the resolved level into each token (so codex's
;; `"-c model_reasoning_effort={}"` becomes `["-c" "model_reasoning_effort=high"]`);
;; a template without `{}` appends the level as the next arg (so claude's
;; `"--effort"` becomes `["--effort" "high"]`).
;;
;; `:models` maps a canonical, pi-style `provider/model` ID to a sparse row of
;; harness-native spellings, each kind keeping only the spelling for its own provider (a
;; claude spelling on an `anthropic/` row, a codex spelling on an `openai-codex/` row). Pi
;; receives the canonical ID unchanged, so it has no column.
;;
;; `:aliases` maps a short name to its canonical ID, or a weight name to a vector of ranked
;; candidates `{:model <short name or canonical ID> :rank n}` with an optional exact
;; `:quota-scope` selector. An unscoped candidate uses `all_models` only when it is the
;; sole effective scope. Give a model with its own quota scope (for example `model:fable`)
;; that exact selector. Lower rank is preferred; the
;; router chooses among them at spawn from each provider's remaining allowance. A candidate
;; takes at most one string-alias hop and never names another vector alias.
;;
;; `:providers` maps a local provider prefix to its exact quota-axi `:quota-provider`
;; and optional `:reserve` fraction. Empty rows describe local providers.
;; Kimi and Z.AI reporting requires an explicit provider override; no alias names them.
;; `:harnesses <kind> :providers` is the set of providers that kind can run; a kind without
;; it accepts every provider.
;;
;; `:defaults` contains spawn defaults. `:placement` is :split, :tab, or :tab-split;
;; :tab-split chooses tab at root and split below root. Placement is never inherited.
;; The shipped value is :tab-split: with promiscuous spawning, one tab per first-level
;; subagent stays reviewable and recoverable, where splitting every root child produces an
;; ever-narrowing column, while a grandchild still splits so a nested unit reads as a unit.
;;
;; Override chain (project wins): this file (default) ← ~/.agents/subagents/config.edn
;; ← <assignment-root>/.agents/subagents/config.edn. `:models` rows, `:harnesses`
;; entries and `:providers` rows replace wholesale; `:aliases` and `:defaults` merge per key.
{:defaults {:placement :tab-split}
 :harnesses {:pi     {:model-flag "--model" :effort-flag "--thinking"}
             :claude {:model-flag "--model" :effort-flag "--effort" :providers #{"anthropic"}}
             :codex  {:model-flag "--model" :effort-flag "-c model_reasoning_effort={}" :providers #{"openai-codex"}}}
 :providers
 {"anthropic"    {:quota-provider "claude"}
  "openai-codex" {:quota-provider "codex"}
  "lemonade"     {}}
 :models {"anthropic/claude-fable-5-1"  {:claude "fable"}
          "anthropic/claude-opus-5-5"   {:claude "opus"}
          "anthropic/claude-sonnet-5-5" {:claude "sonnet"}
          "anthropic/claude-haiku-5-5"  {:claude "haiku"}
          "openai-codex/gpt-6-astra"    {:codex "gpt-6-astra"}
          "openai-codex/gpt-6.1-sol"    {:codex "gpt-6.1-sol"}
          "openai-codex/gpt-5.6-terra"  {:codex "gpt-5.6-terra"}
          "openai-codex/gpt-6-luna"     {:codex "gpt-6-luna"}}
 :aliases {"heavy"             [{:model "fable"  :rank 1 :quota-scope "model:fable"} {:model "gpt-astra"   :rank 1}]
           "middle"            [{:model "opus"   :rank 1} {:model "gpt-sol"   :rank 1}]
           "light"             [{:model "sonnet" :rank 1} {:model "gpt-terra" :rank 1}]
           "feather"           [{:model "haiku"  :rank 1} {:model "gpt-luna"    :rank 1} {:model "qwen-dense" :rank 2}]
           "qwen-dense"        "lemonade/Qwen3.8-27B-GGUF-Q4_K_M"
           "fable"             "anthropic/claude-fable-5-1"
           "opus"              "anthropic/claude-opus-5-5"
           "sonnet"            "anthropic/claude-sonnet-5-5"
           "haiku"             "anthropic/claude-haiku-5-5"
           "gpt-astra"         "openai-codex/gpt-6-astra"
           "gpt-sol"           "openai-codex/gpt-6.1-sol"
           "gpt-terra"         "openai-codex/gpt-5.6-terra"
           "gpt-luna"          "openai-codex/gpt-6-luna"}}
